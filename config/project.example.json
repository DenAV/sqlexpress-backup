{
  "SchemaVersion": 1,
  "ProjectId": "sample-project",
  "Instance": ".\\SQLEXPRESS",
  "BackupRoot": "D:\\SQLBackups",
  "LogRoot": "C:\\ProgramData\\SqlExpressBackup\\Logs",
  "Account": "SYSTEM",
  "ConnectTimeoutSeconds": 30,
  "CommandTimeoutSeconds": 3600,
  "LockTimeoutSeconds": 300,
  "RetentionDays": 30,
  "MinimumFullBackups": 2,
  "CleanupEnabled": true,
  "Databases": [
    { "Id": "application", "Name": "ApplicationDatabase" }
  ],
  "Jobs": [
    { "Id": "full", "Kind": "Full", "Enabled": true, "Schedule": { "Mode": "Daily", "At": "03:15" } },
    { "Id": "log", "Kind": "Log", "Enabled": true, "Schedule": { "Mode": "Interval", "EveryMinutes": 15 } },
    { "Id": "checkdb", "Kind": "CheckDb", "Enabled": false, "Schedule": { "Mode": "Weekly", "At": "05:00", "Days": ["Sunday"] } },
    { "Id": "indexes", "Kind": "Indexes", "Enabled": false, "MinimumPages": 1000, "MinimumFragmentationPercent": 10, "Schedule": { "Mode": "Weekly", "At": "06:00", "Days": ["Sunday"] } }
  ]
}
